pipeline {
    agent any

    stages {
        stage('clone') {
            steps {
                echo 'Cloning git repo'
                git branch: 'main', url: 'https://github.com/PushpakChaudhari77/Terraform_CICD.git'
            }
        }
            
        stage('Init') {
            steps {
                echo 'terraform init'
                sh 'terraform init'
            }
        }
        stage('Plan') {
            steps {
               echo 'terraform plan'
                sh 'terraform plan'
            }
        }
            stage('Apply/destroy') {
            steps {
                echo 'terraform init'
                sh 'terraform ${action} -auto-approve'
            }
        }
    }
}


